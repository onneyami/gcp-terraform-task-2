pipeline {
    agent any

    environment {
        ARGOCD_APP_NAME = 'wireguard-ui'
        ARGOCD_SERVER   = 'argocd-server.argocd.svc.cluster.local:443'
        ARGOCD_TOKEN    = credentials('argocd-jenkins-token')
    }

    stages {
        stage('Checkout Manifests') {
            steps {
                echo "Pulling latest wireguard-ui manifests from Git..."
                checkout scm
            }
        }

        stage('Trigger ArgoCD Refresh & Sync') {
            steps {
                script {
                    echo "Triggering hard refresh and sync for ${env.ARGOCD_APP_NAME}..."
                    sh '''
                        # 1. Force ArgoCD to refresh Git repository state
                        echo "Refreshing application..."
                        curl -k -s -X GET \
                          -H "Authorization: Bearer ${ARGOCD_TOKEN}" \
                          "https://${ARGOCD_SERVER}/api/v1/applications/${ARGOCD_APP_NAME}?refresh=hard" > /dev/null

                        sleep 2

                        # 2. Trigger Application Sync
                        echo "Triggering sync..."
                        curl -k -s -X POST \
                          -H "Authorization: Bearer ${ARGOCD_TOKEN}" \
                          -H "Content-Type: application/json" \
                          "https://${ARGOCD_SERVER}/api/v1/applications/${ARGOCD_APP_NAME}/sync" \
                          -d '{"revision": "HEAD", "prune": true}'
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Successfully triggered ArgoCD sync for ${env.ARGOCD_APP_NAME}!"
        }
        failure {
            echo "Failed to trigger ArgoCD sync."
        }
    }
}