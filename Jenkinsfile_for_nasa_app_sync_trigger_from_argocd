pipeline {
    agent any

    environment {
        ARGOCD_APP_NAME = 'apod-api'
        ARGOCD_SERVER   = 'argocd-server.argocd.svc.cluster.local:80'
        ARGOCD_TOKEN    = credentials('argocd-jenkins-token')
    }

    stages {
        stage('Checkout Manifests') {
            steps {
                echo "Pulling latest ${env.ARGOCD_APP_NAME} manifests from Git..."
                checkout scm
            }
        }

        stage('Trigger ArgoCD Refresh & Sync') {
            steps {
                script {
                    echo "Triggering hard refresh and sync for ${env.ARGOCD_APP_NAME}..."
                    sh """
                        # 1. Hard refresh application state (forces ArgoCD to fetch latest Git commits)
                        echo "Refreshing application..."
                        curl -s -f -X GET \\
                          -H "Authorization: Bearer \${ARGOCD_TOKEN}" \\
                          "http://${env.ARGOCD_SERVER}/api/v1/applications/${env.ARGOCD_APP_NAME}?refresh=hard" > /dev/null

                        sleep 2

                        # 2. Trigger Application Sync (targeting 'main')
                        echo "Triggering sync..."
                        curl -s -f -X POST \\
                          -H "Authorization: Bearer \${ARGOCD_TOKEN}" \\
                          -H "Content-Type: application/json" \\
                          "http://${env.ARGOCD_SERVER}/api/v1/applications/${env.ARGOCD_APP_NAME}/sync" \\
                          -d '{"revision": "main", "prune": true}'
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Successfully triggered ArgoCD sync for ${env.ARGOCD_APP_NAME}!"
        }
        failure {
            echo "Failed to trigger ArgoCD sync for ${env.ARGOCD_APP_NAME}."
        }
    }
}